+    axis, origin, radius, sign = cyl
+    u, v = _frame(axis)
+    center = vertices.mean(axis=0)
+    pts = vertices - center
+    offset = origin - center
+
+    def parameters(x):
+        n = axis + x[2] * u + x[3] * v
+        return n / np.linalg.norm(n), x[0] * u + x[1] * v
+
+    def residual(x):
+        n, o = parameters(x)
+        d = pts - o
+        return np.linalg.norm(d - np.outer(d @ n, n), axis=1) - x[4]
