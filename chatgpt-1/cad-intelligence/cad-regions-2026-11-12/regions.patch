+    fit = least_squares(residual, start, loss="soft_l1", f_scale=tol / 3, max_nfev=20)
+    if fit.x[4] <= 0:
+        return cyl
+    ax, c = parameters(fit.x)
+    return ax, center + c, float(fit.x[4]), sign
