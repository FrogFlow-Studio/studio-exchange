diff --git a/claude/cad-demo/coarse_bore_evidence.py b/claude/cad-demo/coarse_bore_evidence.py
new file mode 100644
index 0000000..8f3929c
--- /dev/null
+++ b/claude/cad-demo/coarse_bore_evidence.py
@@ -0,0 +1,107 @@
+"""Raw radial evidence for a coarse cylindrical wall."""
+from __future__ import annotations
+
+import numpy as np
+import trimesh
+
+
+class RadialWall:
+    def __init__(self, scan, bore, tol, noise):
+        self.bore = bore
+        self.slack = max(.6 * tol, min(tol, 2.5 * noise))
+        self.extension = max(2 * self.slack, .25 * bore.length)
+        vertices = bore.local(scan.vertices)
+        faces = np.asarray(scan.faces)
+        triangles = vertices[faces]
+        axial = triangles[..., 2]
+        relevant = ((axial.max(axis=1) > -self.extension)
+                    & (axial.min(axis=1) < bore.length + self.extension)
+                    & (np.linalg.norm(triangles[..., :2], axis=2).min(axis=1) < bore.radius + self.slack))
+        ids = np.flatnonzero(relevant)
+        normals = np.asarray(scan.face_normals)[ids] @ bore.frame.T
+        radial = triangles[ids, :, :2].mean(axis=1)
+        inward = np.einsum("ij,ij->i", normals[:, :2], radial) < -.5 * np.linalg.norm(radial, axis=1)
+        ids = ids[inward & (np.abs(normals[:, 2]) < .65)]
+        self.triangles = triangles[ids]
+        self.wall = None
+        if len(ids):
+            used, indices = np.unique(faces[ids], return_inverse=True)
+            self.wall = trimesh.Trimesh(vertices[used], indices.reshape(-1, 3), process=False)
+
+    def hits(self, directions, heights):
+        if self.wall is None:
+            return ()
+        origins = np.column_stack((np.zeros((len(heights), 2)), heights))
+        rays = np.column_stack((directions, np.zeros(len(heights))))
+        face, ray, points = self.wall.ray.intersects_id(
+            origins, rays, return_locations=True, multiple_hits=False)
+        if not len(ray):
+            return ()
+        triangle = self.triangles[face, :, :2]
+        tangent = directions[ray, ::-1] * [-1., 1.]
+        width = np.ptp(np.einsum("nij,nj->ni", triangle, tangent), axis=1)
+        r = self.bore.radius
+        half = np.minimum(width / 2, .65 * r)
+        sag = r - np.sqrt(r*r - half*half)
+        radius = np.linalg.norm(points[:, :2], axis=1)
+        vertex_error = np.max(np.abs(np.linalg.norm(triangle, axis=2) - r), axis=1)
+        return zip(ray.tolist(), radius.tolist(), sag.tolist(), vertex_error.tolist())
+
+    def span(self, tol):
+        """Require radial hits through nearly every direction on consecutive sections."""
+        angles = np.linspace(0, 2 * np.pi, 32, endpoint=False)
+        radial = np.column_stack((np.cos(angles), np.sin(angles)))
+        ext = self.extension
+        length = self.bore.length
+        heights = np.linspace(-ext, length + ext, max(17, min(128, int((length + 2*ext) / (tol/2)) + 1)))
+        hits = np.zeros((len(heights), len(radial)), dtype=bool)
+        for ray, radius, sag, _ in self.hits(np.tile(radial, (len(heights), 1)), np.repeat(heights, len(radial))):
+            r = self.bore.radius
+            if r - self.slack - sag <= radius <= r + self.slack:
+                hits.flat[ray] = True
+        supported = np.flatnonzero((hits.mean(axis=1) >= .78)
+                                   & hits.reshape(len(heights), 8, 4).any(axis=2).all(axis=1))
+        runs = np.split(supported, np.flatnonzero(np.diff(supported) != 1) + 1)
+        matches = [(float(heights[run[0]]), float(heights[run[-1]])) for run in runs if len(run) >= 3
+                   and min(length, heights[run[-1]]) - max(0, heights[run[0]]) >= .48 * length]
+        return matches[0] if len(matches) == 1 else None
+
+    def explain(self, points, low, high, tol):
+        """Match only newly lost samples on this candidate's own cylindrical band."""
+        local = self.bore.local(points)
+        r = self.bore.radius
+        radius = np.linalg.norm(local[:, :2], axis=1)
+        z = local[:, 2]
+        inside = ((z > low) & (z < high) & (radius > 0.)
+                  & (np.abs(radius - r) <= min(r / 3, 3 * tol)))
+        ids = np.flatnonzero(inside)
+        if not len(ids):
+            return {}
+        rows = {}
+        for j, hit, sag, vertex_error in self.hits(local[ids, :2] / radius[ids, None], z[ids]):
+            i = ids[j]
+            drift = abs(radius[i] - hit)
+            error = abs(radius[i] - r)
+            reason = None
+            if vertex_error <= tol and r - tol - sag <= hit <= r + tol:
+                if tol < drift <= tol + sag and abs(hit - r) <= tol:
+                    reason = "cleaning_shift"
+                elif radius[i] < r and error <= tol + sag and drift <= tol:
+                    reason = "chord_and_cleaning"
+            rows[int(i)] = {"reason": reason, "raw_r_mm": hit, "radius_mm": r, "sag_mm": sag,
+                            "clean_radius_mm": float(radius[i]), "clean_to_ray_hit_mm": float(drift),
+                            "raw_vertex_error_mm": vertex_error}
+        return rows
+
+
+
+def explain_losses(points, plans, walls, tol):
+    """Reject losses with no single supported cylindrical explanation."""
+    explanations = [[] for _ in points]
+    for index, plan in enumerate(plans):
+        wall = walls[id(plan.bore)]
+        for sample, evidence in wall.explain(points, plan.low_height, plan.high_height, tol).items():
+            if evidence["reason"] is not None:
+                explanations[sample].append(dict(evidence, patch=index))
+    return [{"point_mm": point.tolist(), "matches": matches, "accepted": len(matches) == 1}
+            for point, matches in zip(points, explanations)]
